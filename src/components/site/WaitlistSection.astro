---
import Waitlist from './Waitlist.astro';

interface Props {
  title: string;
  lead: string;
  source: string;
  button?: string;
  blob?: 'sprout' | 'bloom';
}
const { title, lead, source, button = 'Eintragen', blob = 'bloom' } = Astro.props;
---

<section id="warteliste" class="ink-band">
  <div class="ink-blobs" aria-hidden="true">
    <i style={`width:380px;height:380px;background:var(--${blob}-600);right:10%;top:-200px`}></i>
    <i style="width:300px;height:300px;background:var(--clock);left:-80px;bottom:-200px;opacity:.3"></i>
  </div>
  <div class="wrap" style="position:relative;display:grid;gap:28px">
    <div style="max-width:720px">
      <span class="eyebrow">Warteliste</span>
      <h2 style="margin:12px 0 16px">{title}</h2>
      <p class="lead">{lead}</p>
    </div>
    <Waitlist
      source={source}
      button={button}
      success="Du stehst drauf. Bis bald!"
      note='Mit dem Eintragen akzeptierst du die <a href="/datenschutz/">Datenschutzerklärung</a>.'
    />
  </div>
</section>

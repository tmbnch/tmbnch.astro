---
/**
 * Wartelisten-Formular über Netlify Forms. Netlify erkennt das Formular beim Deploy
 * am Attribut data-netlify; die Einträge stehen danach im Netlify-Dashboard unter "Forms".
 */
interface Props {
  /** Ort auf der Seite, landet als Feld "quelle" in der Einsendung */
  source: string;
  button?: string;
  success?: string;
  note?: string;
  class?: string;
  style?: string;
}
const {
  source,
  button = 'Auf die Warteliste',
  success = 'Danke! Wir melden uns, sobald dein Zugang bereit ist.',
  note,
  class: className,
  style,
} = Astro.props;
---

<div class={className} style={style}>
  <form class="waitlist" name="warteliste" method="POST" data-netlify="true" netlify-honeypot="website" data-waitlist>
    <input type="hidden" name="form-name" value="warteliste" />
    <input type="hidden" name="quelle" value={source} />
    <p hidden><label>Nicht ausfüllen: <input name="website" tabindex="-1" autocomplete="off" /></label></p>
    <input type="email" name="email" required placeholder="du@firma.de" aria-label="E-Mail-Adresse" autocomplete="email" />
    <button class="btn" type="submit">{button}</button>
  </form>
  <div class="waitlist-ok" role="status">✓ {success}</div>
  {note && <p class="waitlist-note" set:html={note} />}
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-waitlist]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      btn.disabled = true;
      try {
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (!res.ok) throw new Error(String(res.status));
        form.classList.add('done');
      } catch {
        btn.disabled = false;
        btn.textContent = 'Nochmal versuchen';
      }
    });
  });
</script>

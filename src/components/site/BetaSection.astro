---
import BetaQuiz from './BetaQuiz.astro';

interface Props {
  lead: string;
  source: string;
  blob?: 'sprout' | 'bloom';
}
const { lead, source, blob = 'bloom' } = Astro.props;
---

<section id="warteliste" class="ink-band">
  <div class="ink-blobs" aria-hidden="true">
    <i style={`width:380px;height:380px;background:var(--${blob}-600);right:10%;top:-200px`}></i>
    <i style="width:300px;height:300px;background:var(--clock);left:-80px;bottom:-200px;opacity:.3"></i>
  </div>
  <div class="wrap beta-grid">
    <div>
      <span class="eyebrow">Beta</span>
      <h2 style="margin:12px 0 16px">Sei bei der Beta dabei.</h2>
      <p class="lead">Ein paar Fragen an dich. {lead}</p>
    </div>
    <BetaQuiz source={source} />
  </div>
</section>

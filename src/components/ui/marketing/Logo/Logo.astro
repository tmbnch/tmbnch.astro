---
/**
 * timebench-Logo: Bildmarke (Werkbank, Uhr, Blatt) plus Wortmarke.
 * Quelle der Bildmarke: rcktbs-tmbnch/docs/brand/tmbnch-logo-colored.svg
 */
import siteConfig from '@/config/site.config';
import logomark from '@/assets/branding/logomark.svg';
import logomarkMono from '@/assets/branding/logomark-mono.svg';

interface Props {
  /** Nur die Bildmarke oder Bildmarke mit Wortmarke */
  variant?: 'logomark' | 'full';
  /** Einfarbige Bildmarke */
  mono?: boolean;
  /** Kantenlänge der Bildmarke in px */
  size?: number;
  class?: string;
}

const { variant = 'full', mono = false, size = 30, class: className } = Astro.props;
const mark = mono ? logomarkMono : logomark;
---

<span class:list={['brand', className]}>
  <img src={mark.src} alt={variant === 'logomark' ? siteConfig.branding.logo.alt : ''} width={size} height={size} />
  {variant === 'full' && <span>time<b>bench</b></span>}
</span>

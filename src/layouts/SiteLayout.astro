---
/**
 * Layout aller Seiten: BaseLayout mit Navigation und Footer.
 */
import BaseLayout from './BaseLayout.astro';
import SiteNav from '@/components/site/SiteNav.astro';
import SiteFooter from '@/components/site/SiteFooter.astro';
import type { Thing, WithContext } from 'schema-dts';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  includeOrgSchema?: boolean;
  extraSchemas?: WithContext<Thing> | WithContext<Thing>[];
  /** Hat die Seite einen eigenen #warteliste-Block? Sonst führt der Button zur Startseite. */
  hasWaitlist?: boolean;
}

const { hasWaitlist = false, ...props } = Astro.props;
---

<BaseLayout {...props}>
  <SiteNav slot="header" waitlistHref={hasWaitlist ? '#warteliste' : '/#warteliste'} />
  <slot />
  <SiteFooter slot="footer" />
</BaseLayout>

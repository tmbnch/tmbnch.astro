---
import '@/styles/global.css';
import SEO from '@/components/seo/SEO.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Plausible from '@/components/seo/Plausible.astro';
import MetaPixel from '@/components/seo/MetaPixel.astro';
import ConsentBanner from '@/components/ui/overlay/ConsentBanner';
import { createWebsiteSchema, createOrganizationSchema } from '@/lib/schema';
import type { Thing, WithContext } from 'schema-dts';
import siteConfig from '@/config/site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  includeOrgSchema?: boolean;
  /** Zusätzliche JSON-LD-Schemas (Software, FAQ, Breadcrumbs). */
  extraSchemas?: WithContext<Thing> | WithContext<Thing>[];
  /** Zusätzliche Klasse am <body>, z. B. die Akzentfarbe einer Lösungsseite */
  bodyClass?: string;
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  nofollow = false,
  includeOrgSchema = false,
  extraSchemas,
  bodyClass,
} = Astro.props;

/** Domain-Verifizierung im Meta Business Manager, siehe .env.example */
const metaDomainVerification = import.meta.env.PUBLIC_META_DOMAIN_VERIFICATION;

const schemas: Array<WithContext<Thing>> = [createWebsiteSchema()];
if (includeOrgSchema) schemas.push(createOrganizationSchema());
if (extraSchemas) schemas.push(...(Array.isArray(extraSchemas) ? extraSchemas : [extraSchemas]));
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href={siteConfig.branding.favicon.svg} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={siteConfig.branding.colors.themeColor} />

    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      noindex={noindex}
      nofollow={nofollow}
    />
    <link rel="alternate" type="text/plain" title="LLM-Inhaltsübersicht" href="/llms.txt" />
    <JsonLd schema={schemas} />
    <Plausible />
    <MetaPixel />
    {metaDomainVerification && <meta name="facebook-domain-verification" content={metaDomainVerification} />}
  </head>

  <body class={bodyClass}>
    <a href="#main-content" class="skip-link">Zum Inhalt springen</a>
    <slot name="header" />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />
    <ConsentBanner />
  </body>
</html>

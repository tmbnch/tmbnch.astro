---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Demo from '@/components/demo/Demo.astro';
import BetaSection from '@/components/site/BetaSection.astro';
import Faq from '@/components/site/Faq.astro';
import Crumbs from '@/components/site/Crumbs.astro';
import { createBreadcrumbSchema, createFAQSchema, createSoftwareSchema } from '@/lib/schema';
import siteConfig from '@/config/site.config';

const faqs = [
  {
    question: 'Muss jeder die Desktop-App installieren?',
    answer: 'Die Web-App reicht zum Erfassen. Die Desktop-App lohnt sich für alle, die viel zwischen Projekten springen und abends die Vorschläge nutzen wollen. Sie läuft auf macOS, Windows und Linux.',
  },
  {
    question: 'Wie kommen unsere Daten aus Toggl rüber?',
    answer: 'Mit einem API-Token aus Toggl. timebench holt Kunden, Projekte, Tags und Einträge und gleicht danach jede Stunde ab, auch Löschungen. Lokale Änderungen in timebench bleiben dabei erhalten.',
  },
  {
    question: 'Wer sieht die Stundensätze?',
    answer: 'Nur Admins und Owner eines Workspace. Mitarbeitende sehen ihre Stunden und ob ein Eintrag abrechenbar ist.',
  },
  {
    question: 'Gibt es eine App fürs Handy?',
    answer: 'Die Web-App ist fürs Handy gebaut: Die Woche zeigt drei Tage, der Monat wird kompakt. Eine eigene App aus dem Store gibt es noch nicht.',
  },
  {
    question: 'Können wir timebench selbst betreiben?',
    answer: 'Ja. timebench läuft mit Docker Compose und PostgreSQL auf eurem eigenen Server. Wer das nicht möchte, nutzt unsere Instanz.',
  },
];

const tree = [
  { level: 0, color: '#4f7cff', name: 'Musterfabrik AG', kind: 'Kunde', hours: '61:30' },
  { level: 1, color: '#4f7cff', name: 'Website Relaunch', kind: 'Projekt', hours: '48:15' },
  { level: 2, name: 'Startseite', kind: 'Task', hours: '21:00' },
  { level: 2, name: 'CMS-Anbindung', kind: 'Task', hours: '27:15' },
  { level: 1, color: '#a0703c', name: 'Wartung & Support', kind: 'Projekt', hours: '13:15' },
  { level: 0, color: '#14a38b', name: 'TechVision UG', kind: 'Kunde', hours: '36:45' },
  { level: 1, color: '#14a38b', name: 'Mobile App', kind: 'Projekt', hours: '36:45' },
  { level: 0, color: '#f08a24', name: 'Studio Halm', kind: 'Kunde', hours: '29:00' },
  { level: 1, color: '#f08a24', name: 'Onlineshop', kind: 'Projekt', hours: '29:00' },
];

const rates = [
  { l: 1, label: 'Person bei diesem Kunden', rate: '105 €' },
  { l: 2, label: 'Satz der Person', rate: '95 €' },
  { l: 3, label: 'Projekt oder Aufgabe', rate: '120 €' },
  { l: 4, label: 'Kunde', rate: '110 €' },
  { l: 5, label: 'Workspace-Standard', rate: '90 €' },
];

const url = `${siteConfig.url}/projektzeiterfassung/`;
const schemas = [
  createSoftwareSchema({ name: 'timebench Projektzeiterfassung', url }),
  createFAQSchema(faqs),
  createBreadcrumbSchema([
    { name: 'Start', url: `${siteConfig.url}/` },
    { name: 'Projektzeiterfassung', url },
  ]),
];
---

<SiteLayout
  title="Projektzeiterfassung"
  description="Projektzeit auf Kunde, Projekt und Aufgabe buchen. Mit Schnelleingabe, Vorschlägen am Tagesende, Stundensätzen, Rundung und Export."
  extraSchemas={schemas}
  hasWaitlist
  accent="bloom"
>
  <header class="shero">
    <div class="wrap">
      <div class="shero-text">
        <Crumbs current="Projektzeiterfassung" />
        <h1>Jede Stunde beim <span class="hl-under">richtigen Kunden</span>.</h1>
        <p class="lead">
          Beschreibung tippen, mit <span class="mono">@</span> das Projekt wählen, Enter. Der Timer läuft, und am Monatsende
          rechnet timebench jede Minute mit dem Stundensatz ab, der für genau diesen Kunden gilt.
        </p>
        <div class="shero-cta">
          <a class="btn" href="#warteliste">Bei der Beta dabei sein</a>
          <a class="btn btn-ghost" href="#report">Report ausprobieren</a>
        </div>
      </div>
      <div class="shero-stage" style="max-width:820px">
        <Demo kind="quick" />
        <p class="hint" style="justify-content:center;margin:14px 0 28px">Probier es selbst: ins Feld klicken und <kbd>@</kbd> tippen.</p>
      </div>
    </div>
  </header>

  <div class="wrap">
    <div class="kpis">
      <div><strong>3 Ebenen</strong><span>Kunde, Projekt, Aufgabe, frei benennbar</span></div>
      <div><strong>15 min</strong><span>Rundung pro Eintrag, pro Kunde änderbar</span></div>
      <div><strong>5 Stufen</strong><span>vom Sonderpreis bis zum Standardsatz</span></div>
      <div><strong>CSV · XLS · PDF</strong><span>Export für die Buchhaltung</span></div>
    </div>
  </div>

  <!-- 01 Struktur -->
  <section>
    <div class="wrap split">
      <div>
        <div class="chapter"><span class="no">01</span><span class="eyebrow">Struktur</span></div>
        <h2>Kunde, Projekt, Aufgabe. Oder wie ihr es nennt.</h2>
        <p class="lead">
          Jeder Workspace legt seine Ebenen selbst fest. Eine Agentur arbeitet mit Kunde, Projekt und Task, eine Kanzlei
          mit Mandant und Akte. Farben vergebt ihr pro Kunde, damit man die Woche auf einen Blick lesen kann.
        </p>
        <p style="margin-top:16px">
          Erfasst wird, wie es zum Tag passt: mit dem Timer, im Kalender oder am Freitag im Stundenzettel. Alle drei zeigen
          dieselben Einträge. <a href="/#tour">Zur Produkt-Tour</a>
        </p>
      </div>
      <div class="tree">
        {tree.map((n, i) => (
          <div class:list={['n', { l1: n.level === 1, l2: n.level === 2 }]} style={`${n.color ? `--c:${n.color};` : ''}${n.level === 0 && i > 0 ? 'margin-top:6px' : ''}`}>
            {n.level < 2 && <i></i>}
            {n.level === 0 ? <b>{n.name}</b> : n.name}
            <span class="lv">{n.kind}</span><span class="hrs">{n.hours}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 Tagesende -->
  <section class="ruled" style="background:linear-gradient(var(--paper),var(--hl-soft))">
    <div class="wrap">
      <div class="sec-head">
        <div class="chapter"><span class="no">02</span><span class="eyebrow">Tagesende</span></div>
        <h2>Die Lücken im Tag haben einen Namen.</h2>
        <p class="lead">
          Ein Kundencall hier, zwanzig Minuten Hotfix dort: Genau das fehlt abends im Stundenzettel. Die Desktop-App hat
          gesehen, in welchem Repo, auf welcher Website oder in welchem Meeting du warst, und schlägt das passende Projekt
          vor. Tipp auf „übernehmen“, bis der Tag lückenlos ist.
        </p>
      </div>
      <Demo kind="gaps" />
      <p class="muted" style="margin-top:14px;font-size:15px">
        Die Aktivitätsdaten dafür bleiben sieben Tage auf deinem Rechner. <a href="/#datenschutz-feature">Was der Tracker sieht</a>
      </p>
    </div>
  </section>

  <!-- 03 Stundensätze -->
  <section class="ruled">
    <div class="wrap split">
      <div>
        <div class="chapter"><span class="no">03</span><span class="eyebrow">Stundensätze</span></div>
        <h2>Der speziellste Satz gewinnt.</h2>
        <p class="lead">
          Ein Sonderpreis für Lena bei Musterfabrik schlägt ihren normalen Satz. Ein Festsatz am Projekt schlägt den
          Kundensatz. Gibt es nichts davon, gilt der Satz des Workspace.
        </p>
        <ul class="checks">
          <li><span><b>Abrechenbar</b> setzt ihr pro Projekt vor und ändert es bei Bedarf am einzelnen Eintrag.</span></li>
          <li><span><b>Mehrere Währungen</b> werden getrennt summiert.</span></li>
          <li><span><b>Sätze sehen nur Admins.</b> Mitarbeitende sehen ihre Stunden.</span></li>
        </ul>
      </div>
      <div data-cascade>
        <div class="seg-sc">
          <button type="button" data-lvl="1" class="on">Lena bei Musterfabrik</button>
          <button type="button" data-lvl="3">Projekt mit Festsatz</button>
          <button type="button" data-lvl="5">Neue Kollegin, neuer Kunde</button>
        </div>
        <div class="cascade">
          {rates.map((r) => (
            <div data-l={r.l} class:list={[{ win: r.l === 1 }]}>
              <span class="lvl">{r.l}</span><span style="flex:1">{r.label}</span><span class="rate">{r.rate}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Report -->
  <section id="report" class="ruled">
    <div class="wrap split rev">
      <div>
        <div class="chapter"><span class="no">04</span><span class="eyebrow">Reports</span></div>
        <h2>Am Monatsende eine Datei für die Rechnung.</h2>
        <p class="lead">
          Gruppiert nach Kunde, Projekt oder Person. Schalte die Rundung ein und aus: Der kleine Aufschlag hinter den
          Stunden zeigt, was die 15 Minuten pro Eintrag ausmachen.
        </p>
        <p class="muted" style="margin-top:14px">
          Einen Report wie „Musterfabrik, immer letzter Monat“ speichert ihr einmal. timebench liefert die abrechenbaren
          Stunden, die Rechnung schreibt euer Buchhaltungsprogramm.
        </p>
      </div>
      <Demo kind="report" />
    </div>
  </section>

  <!-- 05 Umzug -->
  <section class="ruled">
    <div class="wrap split">
      <div>
        <div class="chapter"><span class="no">05</span><span class="eyebrow">Umzug</span></div>
        <h2>Aus Toggl umziehen dauert einen Nachmittag.</h2>
        <p class="lead">
          Der Import übernimmt Kunden, Projekte, Tags und Einträge und gleicht danach jede Stunde ab. Das Team wechselt in
          Ruhe, und bis dahin stimmen die Zahlen in beiden Werkzeugen.
        </p>
        <div class="ints" style="margin-top:22px">
          <span>iCal-Abo</span><span>API-Token</span><span>Kommandozeile</span><span>MCP-Server für KI-Assistenten</span><span>Login mit Google</span><span>Login mit Microsoft</span><span class="soon">weitere Integrationen in Planung</span>
        </div>
      </div>
      <div class="sync">
        <div class="sync-h"><span class="pulse"></span><b>Toggl Track · Studio Nord</b><span class="mono muted" style="font-size:12px">verbunden</span></div>
        <div class="sync-row"><span>Kunden</span><span class="mono">12</span></div>
        <div class="sync-row"><span>Projekte</span><span class="mono">48</span></div>
        <div class="sync-row"><span>Tags</span><span class="mono">31</span></div>
        <div class="sync-row"><span>Einträge seit 2023</span><span class="mono">18.402</span></div>
        <div class="sync-f"><span>Letzter Abgleich: <b data-sync-when>vor 12 Minuten</b> · stündlich</span><button type="button" class="btn btn-sm btn-ghost" data-sync>Jetzt abgleichen</button></div>
        <div class="sync-log" role="status"></div>
      </div>
    </div>
  </section>

  <Faq title="Was Teams vor dem Wechsel wissen wollen" items={faqs} />

  <BetaSection
    lead="Drei kurze Antworten, und wir melden uns, sobald ein Platz für dein Team frei ist."
    source="projektzeiterfassung"
  />
</SiteLayout>

<style is:global>
  .tree { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 16px; font-size: 14px; }
  .tree .n { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: 6px; }
  .tree .n:hover { background: var(--muted-2); }
  .tree .n i { width: 9px; height: 9px; border-radius: 99px; background: var(--c); flex: none; }
  .tree .n .lv { margin-left: auto; font-size: 11px; color: var(--fg-muted); font-family: var(--mono); }
  .tree .n .hrs { font-family: var(--mono); font-size: 12px; color: var(--ink-700); width: 56px; text-align: right; }
  .tree .l1 { padding-left: 30px; }
  .tree .l2 { padding-left: 52px; color: var(--ink-700); }
  .tree .l1::before, .tree .l2::before { content: "└"; color: var(--border); margin-right: -2px; font-family: var(--mono); }
  .seg-sc { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px; }
  .seg-sc button { border: 1px solid var(--border); background: var(--card); border-radius: 99px; padding: 6px 12px; font-size: 13px; cursor: pointer; }
  .seg-sc button.on { background: var(--ink); color: var(--paper); border-color: var(--ink); }
</style>

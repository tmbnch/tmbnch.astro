# Vorlage für die Umgebungsvariablen von timebench.io.
#
# Lokal: diese Datei nach .env.local kopieren und ausfüllen. .env.local ist in
# .gitignore und wird von `pnpm dev` (Astro) und `pnpm dev:netlify` (Netlify CLI
# mit Functions) gelesen.
# Netlify: dieselben Namen unter Site configuration → Environment variables setzen.
#
# Variablen mit PUBLIC_ landen beim Build im Browser-Code und sind öffentlich.
# Secrets deshalb immer ohne PUBLIC_ benennen.

# --- Seite -------------------------------------------------------------------

# Produktions-URL für Sitemap, Canonical und OG-Bilder. Ohne Wert gilt https://timebench.io.
SITE_URL=https://timebench.io

# --- Analyse -----------------------------------------------------------------

# Plausible-Skript-ID, cookielos, kein Einwilligungsbanner nötig.
# Steht im Plausible-Dashboard unter Site Settings → Tracker und hat die Form pa-XXXXXXXX.
# Leer lassen, dann lädt keine Analyse und die Datenschutzerklärung erwähnt Plausible nicht.
# Für das Ziel „Warteliste“ im Dashboard unter Goals ein Custom Event mit diesem Namen anlegen.
PUBLIC_PLAUSIBLE_SCRIPT_ID=

# --- Cookie-Banner und Meta (Facebook/Instagram) -----------------------------

# Cookie-Banner einschalten. Nötig, sobald das Meta-Pixel laufen soll; das Pixel lädt
# erst nach Einwilligung in „Marketing“. Plausible braucht den Banner nicht.
PUBLIC_CONSENT_ENABLED=true
PUBLIC_PRIVACY_POLICY_URL=/datenschutz/

# Datensatz „timebench.io Web“ im Business-Portfolio der rocketbase.io GmbH
# (Events Manager → Datensätze). Bewusst ein eigener, nicht der von rocketbase.io:
# Zielgruppen und Kampagnen-Optimierung sollen sich nicht vermischen.
# Browser-Pixel, mit PUBLIC_ (landet im Browser-Code):
PUBLIC_META_PIXEL_ID=1755967522173018
# Dieselbe ID für die Conversions API in netlify/functions/beta.ts, ohne PUBLIC_:
META_PIXEL_ID=1755967522173018
# Secret. Events Manager → timebench.io Web → Einstellungen → Conversions API →
# Zugriffsschlüssel generieren. Nur in Netlify eintragen, nie einchecken.
META_CAPI_TOKEN=
# Domain-Verifizierung: Business-Einstellungen → Brand Safety → Domains → timebench.io →
# Meta-Tag hinzufügen. Der Wert aus content="…"; nicht geheim, steht im HTML jeder Seite.
PUBLIC_META_DOMAIN_VERIFICATION=r67zr4hagzqjp1k36c92u0c6aoet28
# Nur zum Testen: Test-Event-Code aus Events Manager → Events testen. Danach entfernen.
# META_CAPI_TEST_EVENT_CODE=

# --- Serverless Functions (netlify/functions) --------------------------------

# Beta-Fragebogen (/api/beta) und Kontaktformular (/api/contact) legen jeden Eintrag in
# Netlify Blobs ab (Store "funnel-leads") und stellen ihn dann ans Sales-Backend zu:
# POST {SALES_API_URL}/api/public/funnel-events. Was nicht ankommt, liefert
# lead-redeliver alle zehn Minuten nach. Ohne SALES_API_URL bleibt alles im Blob liegen.
SALES_API_URL=https://sales.rocketbase.io
# Optional, wie in rcktbs.astro: Nur wenn das Sales-Backend einen Token verlangt. Dann geht er
# als Header X-Api-Token mit, sonst bleibt der Header weg. Secret.
# SALES_API_TOKEN=

# Signaturschlüssel für den Bestätigungsschritt ohne JavaScript (netlify/lib/human-check.ts).
# Irgendeine lange Zufallszeichenkette. Ohne Wert gilt SALES_API_TOKEN, sonst ein Zufallswert
# pro Prozess; dann verlieren offene Bestätigungsseiten bei jedem Deploy ihre Gültigkeit.
FORM_TOKEN_SECRET=

# Notnagel-Mail über Plunk, nur wenn das Sales-Backend einen Eintrag nicht annimmt. Optional.
PLUNK_SECRET_KEY=
CONTACT_NOTIFICATION_EMAIL=

# Netlify setzt CONTEXT selbst (dev, deploy-preview, production); nicht eintragen.
# Neue Secrets hier mit leerem Wert ergänzen, damit jeder sieht, was eine Function braucht.

{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    "src/**/*",
    "src/env.d.ts",
    "netlify/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".netlify"
  ]
}
